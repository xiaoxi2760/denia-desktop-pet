# ── 依赖与安装产物 ──────────────────────────────────────────────
node_modules/
.npm-cache/
.electron-cache/

# ── 本机私有配置（含真实 API Key / consoleToken，绝不入库）─────────
# 模板是 config.example.json，那个可以入库
config.local.json

# ── 运行时生成 ──────────────────────────────────────────────────
voice/            # TTS 音频缓存（pruneVoiceDir 只留最新 40 个）
*.log

# ── MMD 素材（约 76 MB / 97 个文件）────────────────────────────
# 不入库的两个原因：
#   1) 体积：让仓库保持在几十 KB 级别，diff 和 clone 都快
#   2) 许可：README 明确写了「模型文件内附原模型的 使用说明 read me，请自行阅读并遵守
#      其中的再配布条款」—— 提交进 git 等于二次再配布，风险不在我们这边。
# 需要还原时从你本机拷贝该目录即可，代码只依赖目录结构不依赖具体文件。
model/

# ── 编辑器 / 系统 ───────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 打包产物（exe 发布目录，体积大且可随时重建）
发布/
